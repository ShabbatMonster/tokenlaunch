{
  "manifest_version": 3,
  "name": "pump migrate",
  "version": "2.0.0",
  "description": "Adds a MIGRATE button to a coin page on Axiom. Migrates a stuck pump.fun or Meteora DBC bonding curve into its pool, and on pump.fun takes the first buy in the same transaction.",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://pump.fun/*",
    "https://mainnet.helius-rpc.com/*",
    "https://api.mainnet-beta.solana.com/*",
    "https://shabbatmonster.github.io/tokenlaunch/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://axiom.trade/*",
    "https://*.axiom.trade/*",
    "https://mainnet.block-engine.jito.wtf/*",
    "https://*.mainnet.block-engine.jito.wtf/*",
    "https://lite-api.jup.ag/*",
    "https://quote-api.jup.ag/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://axiom.trade/*",
        "https://*.axiom.trade/*"
      ],
      "js": [
        "axiom.js"
      ],
      "css": [
        "axiom.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "pump migrate",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "axiom.css"
      ],
      "matches": [
        "https://axiom.trade/*",
        "https://*.axiom.trade/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
