{
  "manifest_version": 3,
  "name": "curve migrate",
  "version": "2.0.0",
  "description": "Migrates a stuck bonding curve into its pool — pump.fun, Meteora DBC, or Pons v2 — with the first buy in the same transaction where the venue allows it. Works from a coin page or from a pasted address.",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://pump.fun/*",
    "https://mainnet.helius-rpc.com/*",
    "https://api.mainnet-beta.solana.com/*",
    "https://shabbatmonster.github.io/tokenlaunch/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://axiom.trade/*",
    "https://*.axiom.trade/*",
    "https://mainnet.block-engine.jito.wtf/*",
    "https://*.mainnet.block-engine.jito.wtf/*",
    "https://lite-api.jup.ag/*",
    "https://quote-api.jup.ag/*",
    "https://rpc.mainnet.chain.robinhood.com/*",
    "https://robinhoodchain.blockscout.com/*",
    "https://solscan.io/*",
    "https://dexscreener.com/*",
    "https://*.dexscreener.com/*",
    "https://birdeye.so/*",
    "https://jup.ag/*",
    "https://gmgn.ai/*",
    "https://*.gmgn.ai/*",
    "https://photon-sol.tinyastro.io/*",
    "https://explorer.solana.com/*",
    "https://solana.fm/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://solscan.io/*",
        "https://dexscreener.com/*",
        "https://*.dexscreener.com/*",
        "https://birdeye.so/*",
        "https://jup.ag/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://photon-sol.tinyastro.io/*",
        "https://explorer.solana.com/*",
        "https://solana.fm/*"
      ],
      "js": [
        "axiom.js"
      ],
      "css": [
        "axiom.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "curve migrate",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "axiom.css"
      ],
      "matches": [
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://solscan.io/*",
        "https://dexscreener.com/*",
        "https://*.dexscreener.com/*",
        "https://birdeye.so/*",
        "https://jup.ag/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://photon-sol.tinyastro.io/*",
        "https://explorer.solana.com/*",
        "https://solana.fm/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
